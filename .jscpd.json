{
    "threshold": 1.64,
    "reporters": ["console", "html"],
    "output": "report/jscpd",
    "ignore": [
        "**/*.json",
        "**/*.svg",
        "**/*.spec.ts",
        "**/*.test.ts",
        "**/build/**",
        "**/dist/**",
        "**/index.html",
        "**/*.md",
        "**/__snapshots__/**",
        "**/__coverage__/**",
        "**/coverage/**",
        "**/node_modules/**",
        "**/ios/**",
        "**/android/**",
        "**/landing/**",
        "**/.worktrees/**",
        "**/.claude/**",
        "**/.agents/**",
        "**/.codex/**"
    ],
    "absolute": false,
    "gitignore": true,
    "blame": true
}
