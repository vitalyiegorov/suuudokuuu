{
    "install-command": "pnpm install --frozen-lockfile",
    "capture-mode": "direct",
    "capture-manifest": [
        {
            "platform": "android",
            "device": "phone-6.4",
            "width": 1080,
            "height": 2400,
            "density": 420,
            "locales": [
                "en",
                "de"
            ],
            "appearances": [
                "light"
            ]
        }
    ],
    "capture-scenes": [
        {
            "name": "home",
            "deepLink": "suuudokuuu://",
            "readySelector": {
                "id": "HomeScreenSelectors.Root"
            }
        },
        {
            "name": "hero-board",
            "deepLink": "suuudokuuu://game",
            "readySelector": {
                "id": "GameScreenSelectors.Root"
            }
        },
        {
            "name": "stats",
            "deepLink": "suuudokuuu://history",
            "readySelector": {
                "id": "HistoryScreenSelectors.Root"
            }
        }
    ],
    "screenshots-dir": "tests/app-tests/flows/screenshots",
    "seed-command": "node tests/app-tests/scripts/ci-seed-scene.ts",
    "settle-seconds": "5",
    "status-bar-override": true,
    "build-env": "APP_VARIANT=production\nSTORE_CAPTURE=1\nORG_GRADLE_PROJECT_reactNativeArchitectures=x86_64\n",
    "upload-screenshots": false,
    "asc-dedupe-screenshots": false,
    "android-target": {
        "name": "production",
        "appDir": "packages/app",
        "appId": "com.vitaliiyehorov.suuudokuuu",
        "prebuildCommand": "npx expo prebuild -p android --clean --no-install"
    },
    "android-gradle-task": ":app:assembleRelease",
    "android-gradle-args": "-x lint -x lintVitalAnalyzeRelease -x lintAnalyzeRelease -PreactNativeArchitectures=x86_64"
}
