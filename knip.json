{
    "ignore": [
        "packages/app/lingui.config.js",
        "packages/app/fingerprint.config.js",
        "packages/hell-corpus/scripts/shared/rate-puzzle-worker.mjs",
        ".agents/**"
    ],
    "ignoreDependencies": [
        "@babel/core",
        "@lingui/format-po",
        "@expo/fingerprint",
        "babel-plugin-react-compiler",
        "eas-build-cache-provider"
    ],
    "workspaces": {
        "packages/field-core": {
            "entry": ["src/index.ts!", "src/react/use-field-snapshot.hook.ts!"]
        },
        "packages/field-dom": {
            "entry": ["src/index.ts!"]
        },
        "packages/landing": {
            "entry": [
                "src/app/**/{page,layout,template,default,error,not-found,global-not-found,loading,route,sitemap,robots,manifest,metadata}.{ts,tsx}!",
                "src/seo/components/**/*.tsx!",
                "src/seo/utils/*.util.ts!",
                "scripts/*.ts!"
            ],
            "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"],
            "ignoreDependencies": ["@expo-google-fonts/inter", "@lingui/swc-plugin"]
        },
        "packages/app": {
            "entry": [
                "{index,cli,main}.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!",
                "vercel-functions/api/**/*.ts!",
                "vercel-functions/shared/create-node-handler.util.ts!",
                "metro/wa-sqlite-factory.web.js!",
                "src/@generic/runtime/sqlite-opfs.worker.ts!",
                "src/@generic/runtime/legacy-kv-store.worker.ts!"
            ]
        },
        "tests/app-tests": {
            "entry": ["scripts/ci-seed-scene.ts", "scripts/compose-app-preview.ts"]
        }
    },
    "ignoreBinaries": ["adb", "convert", "ffmpeg", "sips", "maestro"]
}
