{
    "ignore": [
        "packages/app/lingui.config.js",
        "packages/app/fingerprint.config.js",
        "**/babel.config.js",
        "**/selectors.ts",
        "packages/hell-corpus/scripts/shared/rate-puzzle-worker.mjs"
    ],
    "ignoreDependencies": [
        "@babel/core",
        "@lingui/cli",
        "@lingui/format-po",
        "@expo/fingerprint",
        "babel-jest",
        "babel-plugin-react-compiler",
        "eas-build-cache-provider",
        "serve"
    ],
    "ignoreBinaries": ["run", "xcrun", "maestro", "adb", "sqlite3"],
    "workspaces": {
        "packages/field-core": {
            "entry": ["src/index.ts!", "src/react/use-field-snapshot.hook.ts!"]
        },
        "packages/field-dom": {
            "entry": ["src/index.ts!"]
        },
        "packages/landing": {
            "entry": [
                "src/app/**/{page,layout,template,default,error,not-found,loading,route,sitemap,robots,manifest,metadata}.{ts,tsx}!",
                "src/seo/components/**/*.tsx!",
                "src/seo/utils/*.util.ts!",
                "scripts/*.ts!"
            ],
            "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"],
            "ignoreDependencies": ["@expo-google-fonts/inter"]
        },
        "packages/app": {
            "entry": [
                "{index,cli,main}.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!",
                "vercel-functions/api/**/*.ts!",
                "vercel-functions/shared/create-node-handler.util.ts!"
            ]
        },
        "tests/app-tests": {
            "entry": ["scripts/ci-seed-scene.ts"]
        }
    }
}
