{
    "ignore": [
        "packages/app/lingui.config.js",
        "packages/app/fingerprint.config.js",
        ".agents/skills/**",
        ".claude/skills/**",
        "**/babel.config.js",
        "**/selectors.ts"
    ],
    "ignoreDependencies": [
        "@babel/core",
        "@lingui/cli",
        "@lingui/format-po",
        "@expo/fingerprint",
        "babel-jest",
        "babel-plugin-react-compiler",
        "eas-build-cache-provider"
    ],
    "ignoreBinaries": ["run"],
    "workspaces": {
        "packages/app": {
            "entry": [
                "{index,cli,main}.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!",
                "vercel-functions/api/**/*.ts!"
            ]
        }
