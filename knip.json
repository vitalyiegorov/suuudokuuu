{
    "ignore": [
        "packages/app/lingui.config.js",
        "packages/app/fingerprint.config.js",
        "**/babel.config.js",
        "**/*.web.ts",
        "**/*.web.tsx",
        "packages/screen-chrome/src/edge-fade/utils/edge-fade-get-backdrop-filter.util.ts",
        "packages/screen-chrome/src/edge-fade/interface/web-edge-fade-style.interface.ts",
        "**/selectors.ts"
    ],
    "ignoreDependencies": [
        "@babel/core",
        "@lingui/cli",
        "@lingui/format-po",
        "@expo/fingerprint",
        "babel-jest",
        "babel-plugin-react-compiler",
        "eas-build-cache-provider"
    ],
    "ignoreBinaries": ["run"],
    "workspaces": {
        "packages/app": {
            "entry": ["{index,cli,main}.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!", "vercel-functions/api/**/*.ts!"]
        },
        "packages/solver-bitmask": {
            "ignoreDependencies": ["@suuudokuuu/solver-dlx"]
        }
    }
}
