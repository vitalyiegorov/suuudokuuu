{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "lib": [
            "ES2022",
            "ES2024.Object",
            "ES2024.Collection",
            "ES2024.Promise",
            "ES2024.String",
            "ESNext.Collection",
            "ESNext.Iterator",
            "ESNext.Promise",
            "DOM"
        ],
        "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo.json",
        "types": ["node"]
    },
    "include": ["./specs", "./src", "./playwright.config.ts"],
    "exclude": ["node_modules"]
}
