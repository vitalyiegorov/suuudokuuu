{
    "extends": "../../../tsconfig.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo.json",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2022",
        "types": ["node"],
        "noEmit": true,
        "allowImportingTsExtensions": true
    },
    "include": ["./"],
    "exclude": ["node_modules"]
}
