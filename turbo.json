{
    "$schema": "https://turborepo.dev/schema.json",
    "agentGuidance": false,
    "globalDependencies": ["tsconfig*.json", "types/**", ".env*"],
    "tasks": {
        "ts": {
            "outputs": ["node_modules/.cache/tsbuildinfo.json", "**/node_modules/.cache/tsbuildinfo.json"]
        },
        "effect:check": {
            "outputs": []
        },
        "export:web": {
            "outputs": ["dist/**"],
            "dependsOn": ["^build"]
        },
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "@suuudokuuu/landing#build": {
            "dependsOn": ["^build"],
            "env": ["INDEXNOW_KEY"],
            "outputs": ["out/**", ".next/**", "!.next/cache/**"]
        },
        "test": {},
        "test:coverage": {
            "outputs": ["coverage/**"]
        }
    }
}
