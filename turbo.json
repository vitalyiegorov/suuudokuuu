{
    "$schema": "https://turborepo.com/schema.json",
    "globalDependencies": ["tsconfig*.json", "app.json", ".env*"],
    "tasks": {
        "release": {
            "dependsOn": ["^release"],
            "outputs": ["dist/**", "build/**"]
        },
        "ts": {
            "outputs": ["node_modules/.cache/tsbuildinfo.json", "**/node_modules/.cache/tsbuildinfo.json"]
        },
        "lint": {
            "outputs": []
        },
        "deadcode": {
            "outputs": []
        },
        "cpd": {
            "outputs": ["report/jscpd/**"]
        },
        "export:web": {
            "outputs": ["dist/**"]
        },
        "format": {
            "outputs": []
        },
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "@suuudokuuu/landing#build": {
            "dependsOn": ["^build"],
            "outputs": ["out/**", ".next/**", "!.next/cache/**"]
        },
        "test": {},
        "test:coverage": {
            "outputs": ["coverage/**"]
        },
        "//#cpd": {
            "outputs": ["report/jscpd/**"]
        },
        "//#deadcode": {
            "outputs": []
        }
    }
}
