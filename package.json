{
    "name": "@suuudokuuu/root",
    "version": "1.18.1",
    "private": true,
    "description": "suudokuuu platform",
    "license": "SEE LICENSE IN LICENSE",
    "author": "Vitalii Yehorov",
    "scripts": {
        "build": "turbo run build",
        "build:force": "turbo run build --force",
        "cpd": "jscpd --pattern \"**/*.{ts,tsx}\"",
        "deadcode": "knip",
        "deps:check": "pnpm dedupe --check && pnpm --filter @suuudokuuu/app exec expo install --check",
        "deps:dedupe": "pnpm dedupe",
        "effect:check": "turbo run effect:check",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "i18n:check": "pnpm i18n:sync && git diff --name-only --exit-code HEAD -- packages/app/src/i18n/locales",
        "i18n:sync": "pnpm --filter @suuudokuuu/app i18n:sync",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "postinstall": "turbo run build",
        "prepare": "husky",
        "release": "lerna publish --yes --conventional-commits --create-release=github -m \"chore: release %s [skip ci]\"",
        "test": "turbo run test",
        "test:coverage": "turbo run test:coverage",
        "ts": "turbo run ts",
        "ts:force": "turbo run ts --force"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@commitlint/config-workspace-scopes": "^21.2.0",
        "@effect/language-service": "^0.87.3",
        "@eslint-react/eslint-plugin": "^5.23.5",
        "@lingui/cli": "6.9.0",
        "@rnw-community/eslint-plugin": "^2.19.3",
        "@types/node": "^26.6.4",
        "@typescript-eslint/eslint-plugin": "^8.71.0",
        "@typescript-eslint/parser": "^8.71.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "eslint": "^10.12.0",
        "eslint-plugin-lingui": "^0.16.0",
        "eslint-plugin-n": "^18.4.1",
        "eslint-plugin-no-comment-slop": "^0.6.0",
        "eslint-plugin-react-native": "^5.0.0",
        "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
        "eslint-plugin-regexp": "^3.3.1",
        "eslint-plugin-slop": "^0.1.3",
        "husky": "^9.1.7",
        "jscpd": "^5.4.0",
        "knip": "^6.39.0",
        "lerna": "^10.0.1",
        "lint-staged": "^17.6.0",
        "oxfmt": "^0.71.0",
        "oxlint": "^1.86.0",
        "oxlint-tsgolint": "^7.0.2003",
        "turbo": "^2.11.7",
        "typescript": "npm:@typescript/typescript6@^6.0.2"
    },
    "engines": {
        "node": ">=22.22.1"
    },
    "packageManager": "pnpm@11.28.3"
}
