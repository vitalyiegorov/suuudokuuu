{
    "name": "@suuudokuuu/root",
    "version": "1.18.1",
    "private": true,
    "description": "suudokuuu platform",
    "license": "SEE LICENSE IN LICENSE",
    "author": "Vitalii Yehorov",
    "scripts": {
        "build": "turbo run build",
        "build:force": "turbo run build --force",
        "cpd": "jscpd --pattern \"**/*.{ts,tsx}\"",
        "deadcode": "knip",
        "deps:check": "pnpm dedupe --check && pnpm --filter @suuudokuuu/app exec expo install --check",
        "deps:dedupe": "pnpm dedupe",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "i18n:check": "pnpm i18n:sync && git diff --name-only --exit-code HEAD -- packages/app/src/i18n/locales packages/landing/src/i18n/locales",
        "i18n:sync": "pnpm --filter @suuudokuuu/app --filter @suuudokuuu/landing i18n:sync",
        "lint": "effect-tsgo --tsrs-lint oxlint --type-aware",
        "lint:fix": "effect-tsgo --tsrs-lint oxlint --type-aware --fix",
        "postinstall": "turbo run build",
        "prepare": "husky",
        "release": "lerna publish --yes --conventional-commits --create-release=github -m \"chore: release %s [skip ci]\"",
        "test": "turbo run test",
        "test:coverage": "turbo run test:coverage",
        "ts": "turbo run ts",
        "ts:force": "turbo run ts --force"
    },
    "devDependencies": {
        "@babel/core": "7.29.13",
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@commitlint/config-pnpm-scopes": "21.2.2",
        "@effect/tsgo": "0.67.4",
        "@eslint-react/eslint-plugin": "5.28.8",
        "@lingui/cli": "6.12.0",
        "@rnw-community/eslint-plugin": "3.0.5",
        "@types/node": "26.6.6",
        "@typescript-eslint/eslint-plugin": "8.72.1",
        "@typescript-eslint/parser": "8.72.1",
        "eslint": "10.14.0",
        "eslint-plugin-lingui": "0.16.0",
        "eslint-plugin-n": "18.5.0",
        "eslint-plugin-no-comment-slop": "0.6.0",
        "eslint-plugin-react-native": "5.0.0",
        "eslint-plugin-react-you-might-not-need-an-effect": "1.1.0",
        "eslint-plugin-regexp": "3.3.3",
        "eslint-plugin-slop": "0.1.3",
        "husky": "9.1.7",
        "jscpd": "5.4.2",
        "knip": "6.44.1",
        "lerna": "10.1.1",
        "lint-staged": "17.6.0",
        "oxfmt": "0.76.0",
        "oxlint": "1.91.0",
        "tsrs": "0.22.0-ts7.1.0-beta",
        "turbo": "2.11.10",
        "typescript": "npm:@typescript/typescript6@6.0.2"
    },
    "engines": {
        "node": ">=26.13.0"
    },
    "packageManager": "pnpm@12.18.0"
}
