{
    "name": "@suuudokuuu/encoder",
    "version": "1.56.1",
    "private": true,
    "sideEffects": "false",
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "types": "./dist/esm/index.d.ts"
        }
    },
    "main": "dist/esm/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "files": [
        "dist/**/*"
    ],
    "scripts": {
        "build": "yarn build:esm && rm -rf ./dist/*/*.tsbuildinfo",
        "build:esm": "run -T tsc --pretty -p tsconfig.build-esm.json",
        "lint": "run -T eslint --fix src",
        "test": "run -T jest",
        "test:coverage": "run -T jest --coverage",
        "ts": "run -T tsc -p ."
    },
    "dependencies": {
        "@rnw-community/shared": "^1.3.0",
        "@suuudokuuu/generator": "workspace:*",
        "@thi.ng/bitstream": "^2.4.35",
        "lz-string": "^1.4.4"
    }
}
