{
    "name": "@suuudokuuu/encoder",
    "version": "2.13.2",
    "private": true,
    "files": [
        "dist/**/*"
    ],
    "sideEffects": false,
    "main": "dist/esm/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "types": "./dist/esm/index.d.ts"
        }
    },
    "scripts": {
        "build": "pnpm build:esm && find ./dist -name '*.tsbuildinfo' -delete",
        "build:esm": "tsc --pretty -p tsconfig.build-esm.json",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "ts": "tsc -p . && tsc -p tsconfig.test.json"
    },
    "dependencies": {
        "@rnw-community/shared": "^2.15.0",
        "@thi.ng/bitstream": "^2.4.55",
        "lz-string": "^1.5.0"
    },
    "devDependencies": {
        "@suuudokuuu/test-kit": "workspace:*",
        "@vitest/coverage-v8": "5.0.3",
        "vite": "^8.3.2",
        "vitest": "5.0.3"
    }
}
