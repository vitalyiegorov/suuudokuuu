{
    "name": "@suuudokuuu/encoder",
    "version": "2.9.0",
    "private": true,
    "sideEffects": "false",
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "types": "./dist/esm/index.d.ts"
        }
    },
    "main": "dist/esm/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "files": [
        "dist/**/*"
    ],
    "scripts": {
        "build": "yarn build:esm && find ./dist -name '*.tsbuildinfo' -delete",
        "build:esm": "run -T tsc --pretty -p tsconfig.build-esm.json",
        "lint": "run -T eslint --fix src",
        "test": "run -T jest",
        "test:coverage": "run -T jest --coverage",
        "ts": "run -T tsc -p ."
    },
    "dependencies": {
        "@rnw-community/shared": "^2.2.0",
        "@thi.ng/bitstream": "^2.4.53",
        "lz-string": "^1.5.0"
    }
}
