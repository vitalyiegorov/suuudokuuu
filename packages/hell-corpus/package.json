{
    "name": "@suuudokuuu/hell-corpus",
    "version": "2.11.2",
    "private": true,
    "sideEffects": "false",
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        }
    },
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "files": [
        "dist/**/*"
    ],
    "scripts": {
        "build": "yarn build:esm && yarn build:cjs && find ./dist -name '*.tsbuildinfo' -delete",
        "build:cjs": "run -T tsc --pretty -p tsconfig.build-cjs.json",
        "build:corpus": "node ./scripts/build-corpus.mjs",
        "build:esm": "run -T tsc --pretty -p tsconfig.build-esm.json",
        "build:infinity-corpus": "node ./scripts/build-infinity-corpus.mjs",
        "lint": "run -T eslint --fix src",
        "test": "run -T jest",
        "test:coverage": "run -T jest --coverage",
        "ts": "run -T tsc -p ."
    },
    "dependencies": {
        "@rnw-community/shared": "^2.2.0",
        "@suuudokuuu/solver-core": "workspace:*"
    },
    "devDependencies": {
        "@suuudokuuu/rating": "workspace:*",
        "@suuudokuuu/solver-bitmask": "workspace:*",
        "@suuudokuuu/solver-dlx": "workspace:*"
    }
}
