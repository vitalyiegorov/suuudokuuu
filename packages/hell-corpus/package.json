{
    "name": "@suuudokuuu/hell-corpus",
    "version": "2.13.6",
    "private": true,
    "files": [
        "dist/**/*"
    ],
    "sideEffects": false,
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        }
    },
    "scripts": {
        "build": "pnpm build:esm && pnpm build:cjs && find ./dist -name '*.tsbuildinfo' -delete",
        "build:cjs": "tsc --pretty -p tsconfig.build-cjs.json",
        "build:corpus": "node ./scripts/build-corpus.mjs",
        "build:esm": "tsc --pretty -p tsconfig.build-esm.json",
        "build:infinity-corpus": "node ./scripts/build-infinity-corpus.mjs",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "ts": "tsc -p . && tsc -p tsconfig.test.json"
    },
    "dependencies": {
        "@rnw-community/shared": "^2.15.0",
        "@suuudokuuu/solver-core": "workspace:*"
    },
    "devDependencies": {
        "@suuudokuuu/rating": "workspace:*",
        "@suuudokuuu/solver-bitmask": "workspace:*",
        "@suuudokuuu/solver-dlx": "workspace:*",
        "@suuudokuuu/techniques": "workspace:*",
        "@suuudokuuu/test-kit": "workspace:*",
        "@vitest/coverage-v8": "5.0.3",
        "vite": "^8.3.2",
        "vitest": "5.0.3"
    }
}
