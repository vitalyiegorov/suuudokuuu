{
    "name": "@suuudokuuu/techniques",
    "version": "2.13.2",
    "private": true,
    "sideEffects": false,
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        }
    },
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "files": [
        "dist/**/*"
    ],
    "scripts": {
        "bench": "node scripts/benchmark.mjs",
        "bench:profile": "node --cpu-prof --cpu-prof-dir=.bench-profiles scripts/benchmark.mjs",
        "bench:summary": "node scripts/profile-summary.mjs",
        "build": "yarn build:esm && yarn build:cjs && find ./dist -name '*.tsbuildinfo' -delete",
        "build:cjs": "run -T tsc --pretty -p tsconfig.build-cjs.json",
        "build:esm": "run -T tsc --pretty -p tsconfig.build-esm.json",
        "lint": "run -T eslint --fix src test",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "ts": "run -T tsc -p . && run -T tsc -p tsconfig.test.json"
    },
    "dependencies": {
        "@rnw-community/shared": "^2.15.0",
        "@suuudokuuu/generator": "workspace:*"
    },
    "devDependencies": {
        "@suuudokuuu/test-kit": "workspace:*",
        "@vitest/coverage-v8": "5.0.3",
        "vite": "^8.3.2",
        "vitest": "5.0.3"
    }
}
