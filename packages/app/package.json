{
    "name": "@suuudokuuu/app",
    "version": "1.66.2",
    "private": true,
    "scripts": {
        "android": "expo run:android",
        "i18n:compile": "run -T lingui compile --typescript && run -T prettier --write \"src/i18n/locales/*/messages.ts\"",
        "i18n:extract": "run -T lingui extract --overwrite --clean",
        "i18n:sync": "yarn i18n:extract && yarn i18n:compile",
        "ios": "expo run:ios",
        "ios:device": "expo run:ios --device",
        "lint": "run -T eslint --fix src vercel-functions",
        "prebuild": "expo prebuild --clean",
        "start": "expo start --dev-client -c",
        "test": "run -T jest",
        "test:coverage": "run -T jest --coverage",
        "ts": "run -T tsc -p .",
        "web": "expo start --web"
    },
    "dependencies": {
        "@expo-google-fonts/inter": "^0.4.2",
        "@expo/fingerprint": "~0.20.3",
        "@expo/ui": "~57.0.4",
        "@formatjs/intl-pluralrules": "^6.3.10",
        "@lingui/core": "6.4.0",
        "@lingui/react": "6.4.0",
        "@react-native-masked-view/masked-view": "^0.3.2",
        "@reduxjs/toolkit": "^2.12.0",
        "@rnw-community/shared": "^2.2.0",
        "@suuudokuuu/encoder": "workspace:*",
        "@suuudokuuu/generator": "workspace:*",
        "@suuudokuuu/screen-chrome": "workspace:*",
        "@suuudokuuu/solver": "workspace:*",
        "@suuudokuuu/ui": "workspace:*",
        "date-fns": "^4.4.0",
        "expo": "~57.0.4",
        "expo-blur": "~57.0.0",
        "expo-build-properties": "~57.0.3",
        "expo-constants": "~57.0.3",
        "expo-dev-client": "~57.0.5",
        "expo-device": "~57.0.0",
        "expo-font": "~57.0.0",
        "expo-glass-effect": "~57.0.0",
        "expo-haptics": "~57.0.0",
        "expo-linear-gradient": "~57.0.0",
        "expo-linking": "~57.0.2",
        "expo-localization": "~57.0.0",
        "expo-router": "~57.0.4",
        "expo-sharing": "~57.0.3",
        "expo-splash-screen": "~57.0.2",
        "expo-sqlite": "~57.0.0",
        "expo-status-bar": "~57.0.0",
        "expo-system-ui": "~57.0.0",
        "expo-updates": "~57.0.6",
        "lucide-react-native": "^1.21.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-native": "0.86.0",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-reanimated": "4.5.0",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "4.25.2",
        "react-native-share": "^12.3.1",
        "react-native-svg": "15.15.4",
        "react-native-web": "^0.21.2",
        "react-native-worklets": "0.10.0",
        "react-redux": "^9.3.0",
        "redux": "^5.0.1",
        "redux-persist": "^6.0.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@lingui/babel-plugin-lingui-macro": "6.4.0",
        "@lingui/format-po": "6.4.0",
        "@react-native/jest-preset": "0.86.1",
        "@react-native/metro-config": "0.86.0",
        "@testing-library/react-native": "^14.0.1",
        "@types/react": "~19.2.14",
        "babel-plugin-macros": "^3.1.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "eas-build-cache-provider": "^20.0.0",
        "test-renderer": "^1.2.0"
    }
}
