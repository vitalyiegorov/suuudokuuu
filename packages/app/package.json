{
    "name": "@suuudokuuu/app",
    "version": "2.44.3",
    "private": true,
    "main": "index.ts",
    "scripts": {
        "android": "expo run:android",
        "build:vercel": "node scripts/build-vercel-output.ts",
        "export:web": "expo export --platform=web",
        "i18n:compile": "lingui compile --typescript",
        "i18n:extract": "lingui extract --overwrite --clean",
        "i18n:sync": "pnpm i18n:extract && pnpm i18n:compile",
        "ios": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo run:ios",
        "ios:device": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo run:ios --device",
        "prebuild": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo prebuild --clean",
        "start": "expo start --dev-client -c",
        "store:notes": "node scripts/generate-store-release-notes.ts",
        "dev-build:preflight": "node scripts/preflight-development-build.ts",
        "ts": "tsrs -p . && tsrs -p scripts && tsrs -p vercel-functions",
        "web": "expo start --web"
    },
    "dependencies": {
        "@effect/atom-react": "4.1.2",
