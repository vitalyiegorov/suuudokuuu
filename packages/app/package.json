{
    "name": "@suuudokuuu/app",
    "version": "2.11.3",
    "private": true,
    "main": "index.ts",
    "scripts": {
        "android": "expo run:android",
        "build:vercel": "node scripts/build-vercel-output.ts",
        "export:web": "expo export --platform=web",
        "i18n:compile": "run -T lingui compile --typescript && run -T prettier --write \"src/i18n/locales/*/messages.ts\"",
        "i18n:extract": "run -T lingui extract --overwrite --clean",
        "i18n:sync": "yarn i18n:extract && yarn i18n:compile",
        "ios": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo run:ios",
        "ios:device": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo run:ios --device",
        "lint": "run -T eslint --fix src vercel-functions",
        "prebuild": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo prebuild --clean",
        "start": "expo start --dev-client -c",
        "store:notes": "node scripts/generate-store-release-notes.ts",
        "dev-build:preflight": "node scripts/preflight-development-build.ts",
        "test": "run -T jest",
        "test:coverage": "run -T jest --coverage",
        "ts": "run -T tsc -p . && run -T tsc -p scripts",
        "web": "expo start --web"
    },
    "dependencies": {
        "@expo-google-fonts/inter": "^0.4.2",
        "@expo/fingerprint": "~0.20.11",
        "@expo/ui": "~57.0.14",
        "@formatjs/intl-pluralrules": "^6.3.10",
        "@lingui/core": "6.4.0",
        "@lingui/react": "6.4.0",
        "@react-native-masked-view/masked-view": "^0.3.2",
        "@reduxjs/toolkit": "^2.12.0",
        "@rnw-community/shared": "^2.2.0",
        "@shopify/react-native-skia": "2.6.2",
        "@suuudokuuu/encoder": "workspace:*",
        "@suuudokuuu/field-core": "workspace:*",
        "@suuudokuuu/generator": "workspace:*",
        "@suuudokuuu/puzzle-forge": "workspace:*",
        "@suuudokuuu/rating": "workspace:*",
        "@suuudokuuu/screen-chrome": "workspace:*",
        "@suuudokuuu/techniques": "workspace:*",
        "@suuudokuuu/ui": "workspace:*",
        "date-fns": "^4.4.0",
        "expo": "~57.0.18",
        "expo-blur": "~57.0.2",
        "expo-build-properties": "~57.0.15",
        "expo-constants": "~57.0.16",
        "expo-dev-client": "~57.0.16",
        "expo-font": "~57.0.2",
        "expo-glass-effect": "~57.0.0",
        "expo-haptics": "~57.0.2",
        "expo-linear-gradient": "~57.0.1",
        "expo-linking": "~57.0.8",
        "expo-localization": "~57.0.1",
        "expo-router": "~57.0.17",
        "expo-screen-capture": "~57.0.2",
        "expo-sharing": "~57.0.16",
        "expo-splash-screen": "~57.0.8",
        "expo-sqlite": "~57.0.2",
        "expo-status-bar": "~57.0.1",
        "expo-system-ui": "~57.0.3",
        "expo-updates": "~57.0.19",
        "lucide-react-native": "^1.38.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-native": "0.86.3",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-nitro-modules": "^0.36.1",
        "react-native-reanimated": "4.5.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "4.26.0",
        "react-native-share": "^12.3.1",
        "react-native-svg": "15.15.4",
        "react-native-unistyles": "patch:react-native-unistyles@npm%3A3.3.0#~/.yarn/patches/react-native-unistyles-npm-3.3.0-ad7eeefa22.patch",
        "react-native-web": "^0.21.2",
        "react-native-worklets": "0.10.1",
        "react-redux": "^9.3.0",
        "reanimated-color-picker": "^5.1.2",
        "redux": "^5.0.1",
        "redux-persist": "^6.0.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@anthropic-ai/sdk": "^0.115.0",
        "@babel/core": "^7.29.7",
        "@lingui/babel-plugin-lingui-macro": "6.4.0",
        "@lingui/format-po": "6.4.0",
        "@react-native/jest-preset": "0.86.1",
        "@react-native/metro-config": "0.86.0",
        "@testing-library/react-native": "^14.0.1",
        "@types/react": "~19.2.14",
        "babel-plugin-macros": "^3.1.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "eas-build-cache-provider": "^20.0.0",
        "esbuild": "^0.25.1",
        "test-renderer": "^1.2.0"
    }
}
