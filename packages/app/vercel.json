{
    "buildCommand": "",
    "outputDirectory": ".",
    "routes": [
        {
            "src": "^/(?!\\.well-known/)(.*)$",
            "has": [{ "type": "host", "value": "suuudokuuu.com" }],
            "status": 308,
            "headers": {
                "Location": "https://www.suuudokuuu.com/$1"
            }
        },
        {
            "src": "/ota/manifest\\.plist",
            "dest": "/api/beta/manifest"
        },
        {
            "src": "/beta/?",
            "headers": {
                "X-Robots-Tag": "noindex, follow"
            },
            "continue": true
        },
        {
            "src": "^/(?:play|game|game-settings|pause|winner|loser|challenge-won|challenge-lost|scoring|privacy-policy|beta|daily)/?$",
            "dest": "/_app/index.html"
        },
        {
            "src": "^/(?:shared|history|settings)(?:/.*)?$",
            "dest": "/_app/index.html"
        },
        { "handle": "filesystem" },
        { "src": "/.*", "status": 404, "dest": "/404.html" }
    ]
}
