require "zlib"
require "json"
require "open3"

default_platform(:ios)

skip_docs

# fastlane runs lane bodies from the fastlane folder and actions from the
# package folder, so every path a lane resolves itself is anchored here
# instead of relying on the working directory.
FASTLANE_DIR = File.expand_path(__dir__)
APP_DIR = File.expand_path("..", FASTLANE_DIR)
IOS_METADATA_PATH = File.join(FASTLANE_DIR, "metadata", "ios")
ANDROID_METADATA_PATH = File.join(FASTLANE_DIR, "metadata", "android")
IOS_COPYRIGHT_PATH = File.join(IOS_METADATA_PATH, "copyright.txt")

# deliver assigns App Store screenshot slots by resolution, so a set captured
# at the wrong size uploads alongside the existing store images instead of
# replacing them.
APPLE_SCREENSHOT_SLOTS = {
  [1320, 2868] => 'iPhone 6.9"',
  [1290, 2796] => 'iPhone 6.9"',
  [1284, 2778] => 'iPhone 6.5"',
  [1242, 2688] => 'iPhone 6.5"',
  [1206, 2622] => 'iPhone 6.3"',
  [1179, 2556] => 'iPhone 6.1"',
  [2064, 2752] => 'iPad 13"',
  [2752, 2064] => 'iPad 13"',
  [2048, 2732] => 'iPad 12.9"',
  [2732, 2048] => 'iPad 12.9"'
}
REQUIRED_IOS_SCREENSHOT_COUNTS = { 'iPhone 6.9"' => 9, 'iPad 13"' => 6 }

# deliver writes into the editable App Store version, and a freshly uploaded
# build does not create one on its own. Naming the version explicitly makes
# deliver select or create it instead of failing with "could not find an
# editable version".
def app_store_version
  JSON.parse(File.read(File.join(APP_DIR, "package.json"))).fetch("version")
end

def ios_screenshots_path
  deployed_variants = JSON.parse(File.read(File.join(FASTLANE_DIR, "screenshots", "deployed-variant.json")))
  screenshot_variant = ENV.fetch("SCREENSHOT_VARIANT", deployed_variants.fetch("ios"))

  File.join(FASTLANE_DIR, "screenshots", "variants", screenshot_variant, "ios")
end

# eas submit uploads the bundle to the track named in eas.json, and supply
# defaults to production, so the track is read from the same source instead of
# being repeated here.
def android_submit_track
  submit_track = JSON.parse(File.read(File.join(APP_DIR, "eas.json"))).dig("submit", "production", "android", "track")
  UI.user_error!("eas.json does not define submit.production.android.track") unless submit_track

  submit_track
end

# App Store precheck rejects a copyright that does not carry the current year,
# and it only runs once a build has already been submitted.
def verify_copyright_year
  copyright = File.read(IOS_COPYRIGHT_PATH).strip
  current_year = Time.now.year.to_s
  UI.user_error!("#{IOS_COPYRIGHT_PATH} reads '#{copyright}' but must carry #{current_year}") unless copyright.include?(current_year)

  UI.success("Copyright: #{copyright}")
end

def png_header(path)
  UI.user_error!("Missing PNG artwork at #{path}") unless File.file?(path)
  contents = File.binread(path)
  header = contents[0, 33]

  unless header.bytesize == 33 && header[0, 8] == "\x89PNG\r\n\x1a\n".b && header[8, 8] == [13].pack("N") + "IHDR"
    UI.user_error!("#{path} has an invalid PNG signature or IHDR header")
  end

  unless Zlib.crc32(header[12, 17]) == header[29, 4].unpack1("N")
    UI.user_error!("#{path} has an invalid PNG IHDR checksum")
  end

  width, height, bit_depth, color_type, compression, filter, interlace = header[16, 13].unpack("N2C5")
  unless width.positive? && height.positive? && compression.zero? && filter.zero? && [0, 1].include?(interlace)
    UI.user_error!("#{path} has invalid PNG IHDR fields")
  end

  offset = 33
  has_image_data = false

  while offset < contents.bytesize
    UI.user_error!("#{path} has a truncated PNG chunk header") if contents.bytesize - offset < 12
    chunk_length = contents[offset, 4].unpack1("N")
    chunk_type = contents[offset + 4, 4]
    chunk_end = offset + chunk_length + 12
    UI.user_error!("#{path} has a truncated #{chunk_type} PNG chunk") if chunk_end > contents.bytesize
    unless chunk_type.match?(/\A[A-Za-z]{4}\z/) && chunk_type != "IHDR"
      UI.user_error!("#{path} has an invalid PNG chunk type #{chunk_type}")
    end
    unless Zlib.crc32(contents[offset + 4, chunk_length + 4]) == contents[chunk_end - 4, 4].unpack1("N")
      UI.user_error!("#{path} has an invalid #{chunk_type} PNG chunk checksum")
    end

    has_image_data = true if chunk_type == "IDAT" && chunk_length.positive?
    if chunk_type == "IEND"
      unless chunk_length.zero? && chunk_end == contents.bytesize
        UI.user_error!("#{path} must end with an empty terminal PNG IEND chunk")
      end
      UI.user_error!("#{path} has no PNG IDAT image data") unless has_image_data

      return [width, height, bit_depth, color_type]
    end

    offset = chunk_end
  end

  UI.user_error!("#{path} is missing PNG IDAT image data or a terminal IEND chunk")
end

def verify_rgb_screenshot(path)
  width, height, bit_depth, color_type = png_header(path)
  unless bit_depth == 8 && color_type == 2
    UI.user_error!("#{path} must be an 8-bit RGB PNG without alpha (bit depth #{bit_depth}, color type #{color_type})")
  end

  [width, height]
end

def expected_iphone_filenames(variant)
  filenames = %w[hero-board hell challenge-accept challenge-live customization replay stats infinity].each_with_index.map do |scene, index|
    format("%02d_iphone_%s.png", index + 1, scene)
  end
  filenames << "09_iphone_hero-board-#{variant == 'dark' ? 'light' : 'dark'}.png"
end

def verify_iphone_duo_screenshots(path)
  variant = File.basename(File.dirname(path))
  metadata_locales = Dir.children(IOS_METADATA_PATH).select { |locale| File.directory?(File.join(IOS_METADATA_PATH, locale)) }.sort
  %w[1398x2034 2007x2853].each do |size|
    size_path = File.join(path, size)
    verify_store_directory("iPhone Duo #{size} screenshots", size_path)
    UI.user_error!("#{size_path} locales do not match the iOS metadata locales") unless Dir.children(size_path).sort == metadata_locales

    metadata_locales.each do |locale|
      locale_path = File.join(size_path, locale)
      filenames = Dir.children(locale_path).sort
      UI.user_error!("#{locale_path} does not match the curated #{variant} iPhone filenames") unless filenames == expected_iphone_filenames(variant)

      filenames.each do |filename|
        screenshot = File.join(locale_path, filename)
        UI.user_error!("#{screenshot} must be #{size}") unless verify_rgb_screenshot(screenshot).join("x") == size
      end
    end
  end
end

def verify_ios_screenshot_slots(path)
  verify_store_directory("iOS screenshots", path)
  variant = File.basename(File.dirname(path))
  UI.user_error!("Unknown iOS screenshot variant #{variant} at #{path}") unless ["dark", "light"].include?(variant)
  expected_filenames = expected_iphone_filenames(variant)
  expected_filenames.concat(%w[hero-board hell challenge-live editor infinity home].each_with_index.map do |scene, index|
    format("%02d_ipad_%s.png", index + 21, scene)
  end)
  metadata_locales = Dir.children(IOS_METADATA_PATH).select { |locale| File.directory?(File.join(IOS_METADATA_PATH, locale)) }.sort
  UI.user_error!("No iOS metadata locales found under #{IOS_METADATA_PATH}") if metadata_locales.empty?
  unexpected_locales = Dir.children(path) - metadata_locales
  UI.user_error!("Unexpected iOS screenshot entries under #{path}: #{unexpected_locales.join(', ')}") unless unexpected_locales.empty?

  metadata_locales.each do |locale|
    locale_path = File.join(path, locale)
    verify_store_directory("iOS screenshots for #{locale}", locale_path)
    filenames = Dir.children(locale_path).sort
    slot_counts = Hash.new(0)

    filenames.each do |filename|
      screenshot = File.join(locale_path, filename)
      width, height = verify_rgb_screenshot(screenshot)
      slot = APPLE_SCREENSHOT_SLOTS[[width, height]]
      UI.user_error!("#{screenshot} is #{width}x#{height}, which matches no App Store screenshot size") if slot.nil?
      slot_counts[slot] += 1
    end

    slot_counts.sort.each do |slot, count|
      UI.user_error!("#{locale_path} has #{count} #{slot} screenshots; App Store allows at most 10 per device group") if count > 10
      UI.success("  #{locale}: #{slot}: #{count}")
    end

    REQUIRED_IOS_SCREENSHOT_COUNTS.each do |slot, expected_count|
      UI.user_error!("#{locale_path} is missing the required #{slot} screenshot set") unless slot_counts.key?(slot)
      unless slot_counts[slot] == expected_count
        UI.user_error!("#{locale_path} has #{slot_counts[slot]} #{slot} screenshots; the curated gallery requires #{expected_count}")
      end
    end

    unless filenames == expected_filenames
      missing_filenames = expected_filenames - filenames
      unexpected_filenames = filenames - expected_filenames
      UI.user_error!("#{locale_path} does not match the curated #{variant} gallery filenames; missing: #{missing_filenames.join(', ')}; unexpected: #{unexpected_filenames.join(', ')}")
    end
  end
end

def verify_android_artwork(path = ANDROID_METADATA_PATH)
  verify_store_directory("Android metadata", path)
  metadata_locales = Dir.children(path).select { |locale| File.directory?(File.join(path, locale)) }.sort
  UI.user_error!("No Android metadata locales found under #{path}") if metadata_locales.empty?

  metadata_locales.each do |locale|
    images_path = File.join(path, locale, "images")
    { "phoneScreenshots" => 8, "sevenInchScreenshots" => 5, "tenInchScreenshots" => 5 }.each do |folder, expected_count|
      folder_path = File.join(images_path, folder)
      verify_store_directory("Play #{folder} for #{locale}", folder_path)
      screenshots = Dir.children(folder_path).sort
      unless screenshots.length == expected_count
        UI.user_error!("#{folder_path} has #{screenshots.length} screenshots; the curated Play gallery requires #{expected_count}")
      end

      screenshots.each do |filename|
        screenshot = File.join(folder_path, filename)
        width, height = verify_rgb_screenshot(screenshot)
        unless [width, height] == [1080, 1920]
          UI.user_error!("#{screenshot} is #{width}x#{height}; Play screenshots must use the committed 1080x1920 format")
        end
      end
    end

    feature_graphic_path = File.join(images_path, "featureGraphic.png")
    unless png_header(feature_graphic_path) == [1024, 500, 8, 2]
      UI.user_error!("#{feature_graphic_path} must be a 1024x500 8-bit RGB PNG without alpha")
    end

    icon_path = File.join(images_path, "icon.png")
    unless png_header(icon_path) == [512, 512, 8, 6]
      UI.user_error!("#{icon_path} must be a 512x512 8-bit RGBA PNG")
    end
    UI.user_error!("#{icon_path} exceeds Play's 1 MiB icon limit") if File.size(icon_path) > 1024 * 1024
    UI.success("  Play #{locale}: phone and tablet screenshots, feature graphic and icon")
  end
end

def verify_store_directory(label, path)
  UI.user_error!("#{label} is missing at #{path}") unless Dir.exist?(path)
  UI.user_error!("#{label} has no locales at #{path}") if Dir.children(path).empty?

  UI.success("#{label}: #{path}")
end

def validate_creative_asset(path)
  extension = File.extname(path).downcase
  UI.user_error!("#{path}: expected .png, .jpg, or .jpeg") unless %w[.png .jpg .jpeg].include?(extension)
  output, error, status = Open3.capture3("magick", "identify", "-format", "%w|%h|%[channels]|%[colorspace]|%m|%[opaque]", path)
  UI.user_error!("#{path}: ImageMagick could not read image: #{error.strip}") unless status.success?
  width, height, channels, colorspace, format, opaque = output.split("|")
  UI.user_error!("#{path}: extension does not match #{format}") unless (extension == ".png" && format == "PNG") || (%w[.jpg .jpeg].include?(extension) && format == "JPEG")
  UI.user_error!("#{path}: must use RGB/sRGB color without an alpha channel") unless %w[RGB sRGB].include?(colorspace) && !channels.downcase.include?("a") && opaque == "True"

  UI.success("Valid #{File.basename(path)}: #{width}x#{height} #{format} #{colorspace}")
  [width.to_i, height.to_i, extension]
end

def upload_creative_asset(path, library_id, client)
  filename = File.basename(path)
  reservation = client.post("/v1/appAssetLibraryImages", {
    data: {
      type: "appAssetLibraryImages",
      attributes: { fileName: filename, fileSize: File.size(path), category: "CREATIVE_ASSETS", referenceName: File.basename(filename, File.extname(filename)) },
      relationships: { assetLibrary: { data: { type: "appAssetLibraries", id: library_id } } }
    }
  })
  image = reservation.body.fetch("data")
  Spaceship::ConnectAPI::FileUploader.upload(image.fetch("attributes").fetch("uploadOperations"), File.binread(path))
  client.patch("/v1/appAssetLibraryImages/#{image.fetch('id')}", { data: { type: "appAssetLibraryImages", id: image.fetch("id"), attributes: { uploaded: true } } })
  state = client.get("/v1/appAssetLibraryImages/#{image.fetch('id')}").body.fetch("data").fetch("attributes").fetch("state")
  UI.success("Uploaded #{filename}: asset #{image.fetch('id')} is #{state}; check processing and submit it for review in Asset Library")
end

lane :store_preflight do
  UI.success("App Store version: #{app_store_version}")
  UI.success("Google Play track: #{android_submit_track}")

  verify_copyright_year
  verify_store_directory("iOS metadata", IOS_METADATA_PATH)
  verify_store_directory("Android metadata", ANDROID_METADATA_PATH)
  screenshot_paths = ["dark", "light"].map { |variant| File.join(FASTLANE_DIR, "screenshots", "variants", variant, "ios") }
  (screenshot_paths + [ios_screenshots_path]).uniq.each { |path| verify_ios_screenshot_slots(path) }
  verify_iphone_duo_screenshots(File.join(File.dirname(ios_screenshots_path), "iphone-duo"))
  verify_android_artwork
end

platform :ios do
  lane :ios_creative_assets do |options|
    directory = options[:asset_dir]
    UI.user_error!("Pass asset_dir:/absolute/path (add live:true to upload)") unless directory && Dir.exist?(directory)
    paths = Dir.children(directory).sort.map { |name| File.join(directory, name) }
    UI.user_error!("#{directory} contains no creative assets") if paths.empty?
    UI.user_error!("#{directory} must contain files only") unless paths.all? { |path| File.file?(path) }
    dimensions = paths.to_h { |path| [path, validate_creative_asset(path)] }

    UI.message("GET /v1/apps/{appId}/assetLibrary; GET /v1/appAssetLibraryRefData")
    paths.each { |path| UI.message("#{File.basename(path)}: POST /v1/appAssetLibraryImages; uploadOperations; PATCH /v1/appAssetLibraryImages/{imageId}; GET /v1/appAssetLibraryImages/{imageId}") }
    next unless options[:live].to_s == "true"

    app_store_connect_api_key(key_id: ENV["EXPO_ASC_KEY_ID"], issuer_id: ENV["EXPO_ASC_ISSUER_ID"], key_filepath: ENV["EXPO_ASC_API_KEY_PATH"])
    client = Spaceship::ConnectAPI::APIClient.new(token: Spaceship::ConnectAPI.token)
    app_id = JSON.parse(File.read(File.join(APP_DIR, "eas.json"))).dig("submit", "production", "ios", "ascAppId")
    library = client.get("/v1/apps/#{app_id}/assetLibrary").body.fetch("data")
    reference = client.get("/v1/appAssetLibraryRefData").body.fetch("data").first.fetch("attributes")
    creative_types = reference.fetch("placementTypes").select { |placement| placement.fetch("acceptsAssetCategories").include?("CREATIVE_ASSETS") }.map { |placement| placement.fetch("placementTypeId") }
    paths.each do |path|
      width, height, extension = dimensions.fetch(path)
      supported = reference.fetch("imageSpecs").any? do |spec|
        bounds = spec.fetch("dimensions")
        width >= bounds.fetch("minWidth") && width <= bounds.fetch("maxWidth") && height >= bounds.fetch("minHeight") && height <= bounds.fetch("maxHeight") && spec.fetch("fileExtensions").include?(extension) && File.size(path) <= spec.fetch("maxFileSize") && !(spec.fetch("compatiblePlacementTypes") & creative_types).empty?
      end
      UI.user_error!("#{path}: no matching current creative image specification in App Store Connect") unless supported
    end
    paths.each { |path| upload_creative_asset(path, library.fetch("id"), client) }
  end

  lane :ios_metadata do
    app_store_connect_api_key(
      key_id: ENV["EXPO_ASC_KEY_ID"],
      issuer_id: ENV["EXPO_ASC_ISSUER_ID"],
      key_filepath: ENV["EXPO_ASC_API_KEY_PATH"]
    )

    deliver(
      app_version: app_store_version,
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false,
      metadata_path: IOS_METADATA_PATH
    )
  end

  lane :ios_screenshots do
    app_store_connect_api_key(
      key_id: ENV["EXPO_ASC_KEY_ID"],
      issuer_id: ENV["EXPO_ASC_ISSUER_ID"],
      key_filepath: ENV["EXPO_ASC_API_KEY_PATH"]
    )

    deliver(
      app_version: app_store_version,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false,
      metadata_path: IOS_METADATA_PATH,
      screenshots_path: ios_screenshots_path
    )
  end
end

platform :android do
  # supply derives version codes from the binary it uploads, and these lanes
  # upload none, so the release just submitted by eas is looked up on the
  # track instead. Without it supply aborts with "Cannot find changelog
  # because no version code given".
  lane :android_metadata do
    submit_track = android_submit_track
    version_codes = google_play_track_version_codes(track: submit_track)
    UI.user_error!("No release on the '#{submit_track}' track to attach changelogs to") if version_codes.empty?

    supply(
      track: submit_track,
      version_code: version_codes.max,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_screenshots: true,
      skip_upload_images: true,
      metadata_path: ANDROID_METADATA_PATH
    )
  end

  lane :android_screenshots do
    verify_android_artwork

    submit_track = android_submit_track
    version_codes = google_play_track_version_codes(track: submit_track)
    UI.user_error!("No release on the '#{submit_track}' track to attach screenshots to") if version_codes.empty?

    supply(
      track: submit_track,
      version_code: version_codes.max,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_screenshots: false,
      skip_upload_images: false,
      metadata_path: ANDROID_METADATA_PATH
    )
  end
end
