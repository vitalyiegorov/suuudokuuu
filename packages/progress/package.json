{
    "name": "@suuudokuuu/progress",
    "version": "2.13.1",
    "private": true,
    "sideEffects": false,
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "types": "./dist/esm/index.d.ts"
        }
    },
    "main": "dist/esm/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "files": [
        "dist/**/*"
    ],
    "scripts": {
        "build": "yarn build:esm && find ./dist -name '*.tsbuildinfo' -delete",
        "build:esm": "run -T tsc --pretty -p tsconfig.build-esm.json",
        "lint": "run -T eslint --fix src test",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "ts": "run -T tsc -p . && run -T tsc -p tsconfig.test.json"
    },
    "dependencies": {
        "@suuudokuuu/encoder": "workspace:*",
        "@suuudokuuu/field-core": "workspace:*",
        "@suuudokuuu/generator": "workspace:*",
        "@suuudokuuu/techniques": "workspace:*",
        "effect": "4.0.0"
    },
    "devDependencies": {
        "@effect/vitest": "4.0.0",
        "@suuudokuuu/test-kit": "workspace:*",
        "@vitest/coverage-v8": "5.0.3",
        "vite": "^8.3.2",
        "vitest": "5.0.3"
    }
}
