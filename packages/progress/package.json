{
    "name": "@suuudokuuu/progress",
    "version": "2.34.6",
    "private": true,
    "files": [
        "dist/**/*"
    ],
    "sideEffects": false,
    "main": "dist/esm/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "types": "./dist/esm/index.d.ts"
        }
    },
    "scripts": {
        "build": "pnpm build:esm && find ./dist -name '*.tsbuildinfo' -delete",
        "build:esm": "tsrs --pretty -p tsconfig.build-esm.json",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "ts": "tsrs -p . && tsrs -p tsconfig.test.json",
        "effect:check": "effect-language-service diagnostics --project tsconfig.json --format text --severity error"
    },
    "dependencies": {
        "@suuudokuuu/encoder": "workspace:*",
        "@suuudokuuu/field-core": "workspace:*",
        "@suuudokuuu/generator": "workspace:*",
        "@suuudokuuu/techniques": "workspace:*",
        "effect": "4.0.5"
    },
    "devDependencies": {
        "@effect/vitest": "4.0.5",
        "@suuudokuuu/test-kit": "workspace:*",
        "@vitest/coverage-v8": "5.0.5",
        "vite": "^8.3.4",
        "vitest": "5.0.5"
    }
}
