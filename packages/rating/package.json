{
    "name": "@suuudokuuu/rating",
    "version": "2.11.4",
    "private": true,
    "sideEffects": false,
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        }
    },
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "files": [
        "dist/**/*"
    ],
    "scripts": {
        "build": "yarn build:esm && yarn build:cjs && find ./dist -name '*.tsbuildinfo' -delete",
        "build:cjs": "run -T tsc --pretty -p tsconfig.build-cjs.json",
        "build:esm": "run -T tsc --pretty -p tsconfig.build-esm.json",
        "lint": "run -T eslint --fix src",
        "test": "run -T jest",
        "test:coverage": "run -T jest --coverage",
        "ts": "run -T tsc -p ."
    },
    "dependencies": {
        "@suuudokuuu/generator": "workspace:*",
        "@suuudokuuu/techniques": "workspace:*"
    }
}
