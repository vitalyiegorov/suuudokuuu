{
    "name": "@suuudokuuu/rating",
    "version": "2.17.5",
    "private": true,
    "files": [
        "dist/**/*"
    ],
    "sideEffects": false,
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        }
    },
    "scripts": {
        "build": "pnpm build:esm && pnpm build:cjs && find ./dist -name '*.tsbuildinfo' -delete",
        "build:cjs": "tsc --pretty -p tsconfig.build-cjs.json",
        "build:esm": "tsc --pretty -p tsconfig.build-esm.json",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "ts": "tsc -p . && tsc -p tsconfig.test.json"
    },
    "dependencies": {
        "@suuudokuuu/generator": "workspace:*",
        "@suuudokuuu/techniques": "workspace:*"
    },
    "devDependencies": {
        "@suuudokuuu/test-kit": "workspace:*",
        "@vitest/coverage-v8": "5.0.3",
        "vite": "^8.3.2",
        "vitest": "5.0.3"
    }
}
