{
    "name": "@suuudokuuu/field-core",
    "version": "2.11.4",
    "private": true,
    "description": "Headless sudoku field engine with a technique step-script player",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./react": {
            "import": "./dist/esm/react/use-field-snapshot.hook.js",
            "require": "./dist/cjs/react/use-field-snapshot.hook.js"
        }
    },
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "files": [
        "dist/**/*"
    ],
    "scripts": {
        "build": "yarn build:esm && yarn build:cjs && find ./dist -name '*.tsbuildinfo' -delete",
        "build:cjs": "run -T tsc --pretty -p tsconfig.build-cjs.json",
        "build:esm": "run -T tsc --pretty -p tsconfig.build-esm.json",
        "lint": "run -T eslint --fix src",
        "test": "run -T jest",
        "test:coverage": "run -T jest --coverage",
        "ts": "run -T tsc -p ."
    },
    "dependencies": {
        "@rnw-community/shared": "^2.2.0",
        "@suuudokuuu/generator": "workspace:*",
        "@suuudokuuu/techniques": "workspace:*"
    },
    "devDependencies": {
        "@types/react": "~19.2.14",
        "react": "19.2.3"
    },
    "peerDependencies": {
        "react": ">=19.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    }
}
