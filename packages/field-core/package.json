{
    "name": "@suuudokuuu/field-core",
    "version": "2.38.1",
    "private": true,
    "description": "Headless sudoku field engine with a technique step-script player",
    "files": [
        "dist/**/*"
    ],
    "sideEffects": false,
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "exports": {
        ".": {
            "node": "./dist/cjs/index.js",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./react": {
            "node": "./dist/cjs/react/use-field-snapshot.hook.js",
            "import": "./dist/esm/react/use-field-snapshot.hook.js",
            "require": "./dist/cjs/react/use-field-snapshot.hook.js"
        }
    },
    "scripts": {
        "build": "pnpm build:esm && pnpm build:cjs && find ./dist -name '*.tsbuildinfo' -delete",
        "build:cjs": "tsrs --pretty -p tsconfig.build-cjs.json",
        "build:esm": "tsrs --pretty -p tsconfig.build-esm.json",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "ts": "tsrs -p . && tsrs -p tsconfig.test.json"
    },
    "dependencies": {
        "@rnw-community/shared": "2.29.0",
        "@suuudokuuu/generator": "workspace:*",
        "@suuudokuuu/techniques": "workspace:*"
    },
    "devDependencies": {
        "@effect/vitest": "4.1.2",
        "@suuudokuuu/hell-corpus": "workspace:*",
        "@suuudokuuu/rating": "workspace:*",
        "@suuudokuuu/solver-core": "workspace:*",
        "@suuudokuuu/test-kit": "workspace:*",
        "@types/react": "19.3.0",
        "@vitest/coverage-v8": "5.1.0",
        "effect": "4.1.2",
        "react": "19.3.0",
        "vite": "8.3.6",
        "vitest": "5.1.0"
    },
    "peerDependencies": {
        "react": ">=19.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    }
}
