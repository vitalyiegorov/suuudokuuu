{
    "extends": "../../tsconfig.build-cjs.json",
    "compilerOptions": {
        "lib": [
            "ES2022",
            "ES2024.Object",
            "ES2024.Collection",
            "ES2024.Promise",
            "ES2024.String",
            "ESNext.Collection",
            "ESNext.Iterator",
            "ESNext.Promise",
            "DOM"
        ],
        "rootDir": "./src",
        "outDir": "./dist/cjs",
        "module": "node16",
        "moduleResolution": "Node16"
    },
    "include": ["./src"],
    "exclude": ["node_modules", "dist", "**/*.spec.*"]
}
