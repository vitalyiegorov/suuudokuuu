{
    "name": "@suuudokuuu/field-dom",
    "version": "2.13.2",
    "private": true,
    "description": "React DOM board renderer for the headless sudoku field engine",
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./styles.css": "./dist/field-dom.css"
    },
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "files": [
        "dist/**/*"
    ],
    "scripts": {
        "build": "yarn build:esm && yarn build:cjs && yarn build:styles && find ./dist -name '*.tsbuildinfo' -delete",
        "build:cjs": "run -T tsc --pretty -p tsconfig.build-cjs.json",
        "build:esm": "run -T tsc --pretty -p tsconfig.build-esm.json",
        "build:styles": "cp src/styles/field-dom.css dist/field-dom.css",
        "lint": "run -T eslint --fix src test",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "ts": "run -T tsc -p . && run -T tsc -p tsconfig.test.json"
    },
    "dependencies": {
        "@rnw-community/shared": "^2.15.0",
        "@suuudokuuu/field-core": "workspace:*"
    },
    "devDependencies": {
        "@suuudokuuu/test-kit": "workspace:*",
        "@types/react": "~19.3.0",
        "@vitest/coverage-v8": "5.0.3",
        "react": "19.3.0",
        "vite": "^8.3.2",
        "vitest": "5.0.3"
    },
    "peerDependencies": {
        "react": ">=19.0.0"
    }
}
