{
    "name": "@suuudokuuu/field-dom",
    "version": "2.35.7",
    "private": true,
    "description": "React DOM board renderer for the headless sudoku field engine",
    "files": [
        "dist/**/*"
    ],
    "sideEffects": [
        "*.css"
    ],
    "main": "dist/esm/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/esm/index.d.ts",
            "import": "./dist/esm/index.js"
        },
        "./styles.css": "./dist/field-dom.css"
    },
    "scripts": {
        "build": "pnpm build:esm && pnpm build:styles && find ./dist -name '*.tsbuildinfo' -delete",
        "build:esm": "tsrs --pretty -p tsconfig.build-esm.json",
        "build:styles": "cp src/styles/field-dom.css dist/field-dom.css",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "ts": "tsrs -p . && tsrs -p tsconfig.test.json"
    },
    "dependencies": {
        "@rnw-community/shared": "^2.28.0",
        "@suuudokuuu/field-core": "workspace:*"
    },
    "devDependencies": {
        "@suuudokuuu/test-kit": "workspace:*",
        "@types/react": "~19.3.0",
        "@vitest/coverage-v8": "5.0.5",
        "react": "19.3.0",
        "vite": "^8.3.4",
        "vitest": "5.0.5"
    },
    "peerDependencies": {
        "react": ">=19.0.0"
    }
}
