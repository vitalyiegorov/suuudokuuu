#: src/how-to-play/components/how-to-play-page/how-to-play-page.tsx
msgid "<0>Box rule.</0> Each of the nine 3×3 boxes must contain the digits 1 to 9 exactly once each."
msgstr "<0>باکس کا اصول۔</0> نو کے نو 3×3 باکسز میں سے ہر ایک میں 1 سے 9 تک کا ہر ہندسہ ٹھیک ایک بار آنا چاہیے۔"

#: src/how-to-play/components/how-to-play-page/how-to-play-page.tsx
msgid "<0>Column rule.</0> Each of the nine columns must contain the digits 1 to 9 exactly once each."
msgstr "<0>کالم کا اصول۔</0> نو کے نو کالموں میں سے ہر ایک میں 1 سے 9 تک کا ہر ہندسہ ٹھیک ایک بار آنا چاہیے۔"

#: src/how-to-play/components/how-to-play-page/how-to-play-page.tsx
msgid "<0>Easy.</0> Adds hidden singles, still no candidate tracking required."
msgstr "<0>آسان۔</0> پوشیدہ اکہروں کا اضافہ، پھر بھی امکانات کا حساب رکھنے کی ضرورت نہیں۔"

#: src/difficulty/components/sudoku-difficulties-page/sudoku-difficulties-page.tsx
msgid "<0>Easy</0> — {easyClueCount} clues, guaranteed to need at least one hidden single and never more than that."
msgstr "<0>آسان</0> — {easyClueCount} کلیوز، جن میں کم از کم ایک پوشیدہ اکہرا لازمی ہے اور اس سے زیادہ کبھی نہیں۔"

#: src/home/components/home-page/home-page.tsx
msgid "<0>Full House</0> — the simplest possible move, filling the last empty cell in a unit."
msgstr "<0>آخری خالی خانہ</0> — سب سے سادہ چال، یعنی کسی اکائی کا آخری خالی خانہ بھرنا۔"

#: src/how-to-play/components/how-to-play-page/how-to-play-page.tsx
msgid "<0>Hard.</0> Always stalls on subsets and always yields to a fish or a wing pattern."
msgstr "<0>مشکل۔</0> ہمیشہ سبسیٹس پر رک جاتا ہے اور ہمیشہ کسی فش یا ونگ پیٹرن سے حل ہوتا ہے۔"

#: src/difficulty/components/sudoku-difficulties-page/sudoku-difficulties-page.tsx
msgid "<0>Hard</0> — {hardClueCount} clues, guaranteed to stall on subsets and to yield to fish and wing patterns."
msgstr "<0>مشکل</0> — {hardClueCount} کلیوز، جو سبسیٹس پر رک جاتے ہیں اور فش اور ونگ پیٹرنز سے حل ہوتے ہیں۔"

#: src/how-to-play/components/how-to-play-page/how-to-play-page.tsx
msgid "<0>Hell.</0> Always stalls on chains and AIC and always needs a forcing chain, drawn from a bundled, verified corpus."
msgstr "<0>جہنم۔</0> ہمیشہ زنجیروں اور AIC پر رک جاتا ہے اور ہمیشہ جبری زنجیر کا تقاضا کرتا ہے، اور پزلز ایک شامل شدہ، تصدیق شدہ مجموعے سے لیے گئے ہیں۔"

#: src/difficulty/components/sudoku-difficulties-page/sudoku-difficulties-page.tsx
msgid "<0>Hell</0> — guaranteed to stall on AIC and to need a forcing chain, drawn from a bundled, verified corpus rather than generated to a band."
msgstr "<0>جہنم</0> — AIC پر رک جانے والے اور جبری زنجیر کے متقاضی پزلز، جو کسی درجے کے مطابق بنائے جانے کے بجائے ایک شامل شدہ، تصدیق شدہ مجموعے سے لیے گئے ہیں۔"

#: src/home/components/home-page/home-page.tsx
msgid "<0>Hidden Single</0> — a digit that only fits in one cell of a unit."
msgstr "<0>پوشیدہ اکہرا</0> — ایسا ہندسہ جو کسی اکائی کے صرف ایک خانے میں آ سکتا ہے۔"

#: src/how-to-play/components/how-to-play-page/how-to-play-page.tsx
msgid "<0>Infinity.</0> The hardest sudoku puzzles ever published, such as Everest and AI Escargot, chosen by their published rating rather than a technique band — see the <1>Infinity lander</1>."
msgstr "<0>لامحدود۔</0> اب تک شائع ہونے والے سب سے مشکل سوڈوکو پزلز، جیسے Everest اور AI Escargot، جو کسی تکنیکی بینڈ کے بجائے اپنی شائع شدہ ریٹنگ کی بنیاد پر چنے گئے ہیں — <1>لامحدود کا صفحہ</1> دیکھیں۔"

#: src/difficulty/components/sudoku-difficulties-page/sudoku-difficulties-page.tsx
msgid "<0>Infinity</0> — {infinityCorpusSize} of the hardest puzzles ever published, chosen by their published SE rating of {infinityLowestRating} to {infinityHighestRating} rather than by a technique band, and past the reach of every technique on the ladder."
msgstr "<0>لامحدود</0> — اب تک شائع ہونے والے {infinityCorpusSize} سب سے مشکل پزلز، جو کسی تکنیکی بینڈ کے بجائے {infinityLowestRating} سے {infinityHighestRating} کی شائع شدہ SE ریٹنگ کی بنیاد پر چنے گئے ہیں، اور جو سیڑھی کی ہر تکنیک کی پہنچ سے باہر ہیں۔"

#: src/how-to-play/components/how-to-play-page/how-to-play-page.tsx
msgid "<0>Medium.</0> Always stalls on singles and always yields to intersections and subsets — pointing pairs, box line reduction, naked and hidden pairs through quads."
msgstr "<0>درمیانہ۔</0> ہمیشہ اکہروں پر رک جاتا ہے اور ہمیشہ تقاطع اور سبسیٹس سے حل ہوتا ہے — اشارہ کرتے جوڑے، باکس لائن ریڈکشن، اور جوڑوں سے لے کر چوہروں تک کھلے اور پوشیدہ سبسیٹس۔"

#: src/difficulty/components/sudoku-difficulties-page/sudoku-difficulties-page.tsx
msgid "<0>Medium</0> — {mediumClueCount} clues, guaranteed to stall on singles and to yield to intersections and subsets."
msgstr "<0>درمیانہ</0> — {mediumClueCount} کلیوز، جو اکہروں پر رک جاتے ہیں اور تقاطع اور سبسیٹس سے حل ہوتے ہیں۔"

#: src/home/components/home-page/home-page.tsx
msgid "<0>Naked Single</0> — a cell left with exactly one candidate."
msgstr "<0>کھلا اکہرا</0> — ایسا خانہ جس میں ٹھیک ایک ہی امکان باقی رہ گیا ہو۔"

#: src/how-to-play/components/how-to-play-page/how-to-play-page.tsx
msgid "<0>Newbie.</0> Solvable with full houses and naked singles alone."
msgstr "<0>نیا کھلاڑی۔</0> صرف آخری خالی خانوں اور کھلے اکہروں سے حل ہو جاتا ہے۔"

#: src/difficulty/components/sudoku-difficulties-page/sudoku-difficulties-page.tsx
msgid "<0>Newbie</0> — {newbieClueCount} clues, solved with full houses and naked singles alone."
msgstr "<0>نیا کھلاڑی</0> — {newbieClueCount} کلیوز، جو صرف آخری خالی خانوں اور کھلے اکہروں سے حل ہوتے ہیں۔"

#: src/how-to-play/components/how-to-play-page/how-to-play-page.tsx
msgid "<0>Nightmare.</0> Always stalls on fish and wings and always yields to chain or coloring logic."
msgstr "<0>ڈراؤنا خواب۔</0> ہمیشہ فش اور ونگز پر رک جاتا ہے اور ہمیشہ زنجیر یا رنگ کاری کی منطق سے حل ہوتا ہے۔"

#: src/difficulty/components/sudoku-difficulties-page/sudoku-difficulties-page.tsx
msgid "<0>Nightmare</0> — {nightmareClueCount} clues, guaranteed to stall on wings and to yield to chains and coloring."
msgstr "<0>ڈراؤنا خواب</0> — {nightmareClueCount} کلیوز، جو ونگز پر رک جاتے ہیں اور زنجیروں اور رنگ کاری سے حل ہوتے ہیں۔"

#: src/how-to-play/components/how-to-play-page/how-to-play-page.tsx
msgid "<0>Row rule.</0> Each of the nine rows must contain the digits 1 to 9 exactly once each."
msgstr "<0>قطار کا اصول۔</0> نو کی نو قطاروں میں سے ہر ایک میں 1 سے 9 تک کا ہر ہندسہ ٹھیک ایک بار آنا چاہیے۔"

#: src/difficulty/components/easy-sudoku-page/easy-sudoku-page.tsx
msgid "A board that a full-house-and-naked-single solver can finish is rejected as too easy for the tier."
msgstr "جو بورڈ آخری خالی خانے اور کھلے اکہرے والا سولور مکمل کر لے، اسے اس درجے کے لیے حد سے آسان سمجھ کر مسترد کر دیا جاتا ہے۔"

#: src/difficulty/components/newbie-sudoku-page/newbie-sudoku-page.tsx
msgid "A board that needs a hidden single or anything harder is rejected and regenerated, never labelled Newbie."
msgstr "جس بورڈ کو پوشیدہ اکہرے یا اس سے مشکل کسی چیز کی ضرورت ہو، اسے مسترد کر کے دوبارہ بنایا جاتا ہے، اور اسے کبھی نیا کھلاڑی کا نام نہیں دیا جاتا۔"

#: src/difficulty/components/nightmare-sudoku-page/nightmare-sudoku-page.tsx
msgid "A chain follows an alternating sequence of strong and weak links between candidates, starting from one end and reasoning outward until the two ends prove an elimination no matter which of them turns out to be true. X-Chain does this with a single digit; XY-Chain walks a path of bivalue cells instead, changing digit at every step. Simple coloring assigns two alternating colours to a network of strong links on one digit and clears any candidate that can see both colours. AIC folds all of them into one technique, mixing digits and link types along a single continuous chain. The difference from a fish or a wing is not subtlety but shape: a wing is a fixed arrangement of three or four cells you learn to recognise, while a chain has no fixed size and has to be built move by move. Nightmare is capped at AIC — anything that still resists is beyond what the generated tiers will hand you."
msgstr "زنجیر امکانات کے درمیان مضبوط اور کمزور روابط کے باری باری آنے والے سلسلے پر چلتی ہے۔ وہ ایک سرے سے شروع کر کے آگے بڑھتی ہے، یہاں تک کہ دونوں سرے ثابت کر دیں کہ ان میں سے جو بھی سچ نکلے، ایک امکان لازماً ہٹانا پڑے گا۔ X-Chain یہ کام ایک ہی ہندسے کے ساتھ کرتی ہے؛ XY-Chain اس کے بجائے دو امکانات والے خانوں کے راستے پر چلتی ہے اور ہر قدم پر ہندسہ بدل دیتی ہے۔ سادہ رنگ کاری ایک ہندسے کے مضبوط روابط کے جال کو باری باری دو رنگ دیتی ہے اور ہر اس امکان کو ہٹا دیتی ہے جو دونوں رنگ دیکھ سکے۔ AIC ان سب کو ایک ہی تکنیک میں سمو دیتی ہے، جس میں ایک مسلسل زنجیر میں ہندسے اور روابط کی اقسام آپس میں ملتی ہیں۔ فش یا ونگ سے فرق باریکی کا نہیں بلکہ شکل کا ہے: ونگ تین یا چار خانوں کی ایک مقررہ ترتیب ہے جسے آپ پہچاننا سیکھتے ہیں، جبکہ زنجیر کا کوئی مقررہ سائز نہیں ہوتا اور اسے قدم بہ قدم بنانا پڑتا ہے۔ ڈراؤنا خواب AIC تک محدود ہے — جو بورڈ پھر بھی نہ کھلے، وہ بنائے گئے درجوں کی پہنچ سے باہر ہے۔"

#: src/difficulty/components/hell-sudoku-page/hell-sudoku-page.tsx
msgid "A chain follows an alternating sequence of strong and weak links, starting from a candidate and working outward until it proves an elimination or a placement no matter which branch turns out to be true. X-Chain works on a single digit; XY-Chain follows a path of bivalue cells instead. Simple coloring assigns two alternating colours to a network of strong links on one digit and clears any candidate that sees both colours, and AIC generalises the whole family, mixing digits and cell types along one continuous chain. Hell starts where all of that runs out. A forcing chain assumes a candidate, a cell’s possibilities or a house’s placements, follows every consequence, and keeps only what holds in every branch — the <0>Nishio</0>, <1>cell</1> and <2>region forcing chain</2> pages walk through one of each. A board makes the Hell corpus only if its hardest step on the rating-optimal path is a forcing chain, and only if our ladder can still finish it, so no Hell board ever asks you to guess."
msgstr "زنجیر مضبوط اور کمزور روابط کے باری باری آنے والے سلسلے پر چلتی ہے، ایک امکان سے شروع ہو کر باہر کی طرف بڑھتی ہے، یہاں تک کہ یہ ثابت کر دے کہ جو بھی شاخ سچ نکلے، کوئی امکان ہٹانا یا کوئی ہندسہ رکھنا لازم ہے۔ X-Chain ایک ہی ہندسے پر کام کرتی ہے؛ XY-Chain اس کے بجائے دو امکانات والے خانوں کے راستے پر چلتی ہے۔ سادہ رنگ کاری ایک ہندسے کے مضبوط روابط کے جال کو باری باری دو رنگ دیتی ہے اور ہر اس امکان کو ہٹا دیتی ہے جو دونوں رنگ دیکھے، اور AIC پورے خاندان کو عام کر دیتی ہے، جس میں ایک مسلسل زنجیر میں ہندسے اور خانوں کی اقسام آپس میں ملتی ہیں۔ جہنم وہاں سے شروع ہوتا ہے جہاں یہ سب ختم ہو جاتا ہے۔ جبری زنجیر کسی امکان کو فرض کرتی ہے — خانے کے امکانات یا کسی ہاؤس کی جگہوں کو — اس کے ہر نتیجے کا پیچھا کرتی ہے، اور صرف وہی رکھتی ہے جو ہر شاخ میں درست رہے — <0>نیشیو</0>، <1>خانے</1> اور <2>علاقے کی جبری زنجیر</2> کے صفحات ہر ایک کی ایک مثال دکھاتے ہیں۔ کوئی بورڈ جہنم کے مجموعے میں اسی صورت آتا ہے جب ریٹنگ کے لحاظ سے بہترین راستے پر اس کا سب سے مشکل قدم جبری زنجیر ہو، اور ہماری سیڑھی اسے پھر بھی مکمل کر سکتی ہو، اس لیے جہنم کا کوئی بورڈ آپ سے کبھی اندازہ لگانے کو نہیں کہتا۔"

#: src/printable/components/printable-nightmare-sudoku-page/printable-nightmare-sudoku-page.tsx
msgid "A chain has no fixed shape and is built link by link, which is far easier to track by writing each strong and weak link down than by scrolling a small screen."
msgstr "زنجیر کی کوئی مقررہ شکل نہیں ہوتی اور وہ کڑی در کڑی بنتی ہے، جسے چھوٹی اسکرین پر اسکرول کرنے کے مقابلے میں ہر مضبوط اور کمزور رابطہ لکھ کر یاد رکھنا کہیں آسان ہے۔"

#: src/printable/components/printable-nightmare-sudoku-page/printable-nightmare-sudoku-page.tsx
msgid "A chain has no fixed shape, which is why marking it in pencil helps more here than at the easier tiers."
msgstr "زنجیر کی کوئی مقررہ شکل نہیں ہوتی، اسی لیے آسان درجوں کے مقابلے میں یہاں پنسل سے نشان لگانا زیادہ مددگار ہوتا ہے۔"

#: src/printable/components/printable-nightmare-sudoku-page/printable-nightmare-sudoku-page.tsx
msgid "A chain has no fixed shape: it is built link by link, and the only way to keep track of it is to write it down. On paper you can mark each strong and weak link as you go, follow the alternation to the far end, and see immediately which cells both ends can see. That is genuinely awkward on a phone screen you have to scroll. It is also the booklet where a wrong elimination compounds worst: mark a candidate as gone that should have stayed, and every link after it is unsound, so treat the solution pages as a real checkpoint rather than a formality."
msgstr "زنجیر کی کوئی مقررہ شکل نہیں ہوتی: وہ کڑی در کڑی بنتی ہے، اور اسے یاد رکھنے کا واحد طریقہ اسے لکھ لینا ہے۔ کاغذ پر آپ ہر مضبوط اور کمزور رابطہ ساتھ ساتھ نشان زد کر سکتے ہیں، باری باری آنے والے سلسلے کو دوسرے سرے تک دیکھ سکتے ہیں، اور فوراً پہچان سکتے ہیں کہ کون سے خانے دونوں سرے دیکھ سکتے ہیں۔ فون کی اسکرین پر، جسے اسکرول کرنا پڑتا ہے، یہ واقعی مشکل ہے۔ یہ وہ کتابچہ بھی ہے جہاں غلط امکان ہٹانے کی غلطی سب سے زیادہ بڑھتی ہے: جو امکان رہنا چاہیے تھا اسے ہٹا دیں تو اس کے بعد کی ہر کڑی غلط ہو جاتی ہے، اس لیے حل کے صفحات کو رسمی کارروائی کے بجائے ایک حقیقی جانچ سمجھیں۔"

#: src/how-to-play/components/how-to-play-faq/how-to-play-faq.tsx
msgid "A clue, or given, is a digit printed on the board before you start. A candidate is a digit you are still considering for a blank cell, based on what its row, column and box currently rule out."
msgstr "کلیو، یا دیا گیا عدد، وہ ہندسہ ہے جو آپ کے شروع کرنے سے پہلے بورڈ پر چھپا ہوتا ہے۔ امکان وہ ہندسہ ہے جس پر آپ خالی خانے کے لیے ابھی غور کر رہے ہیں، اس بنیاد پر کہ اس کی قطار، کالم اور باکس فی الحال کیا کچھ رد کر چکے ہیں۔"

#: src/printable/components/printable-easy-sudoku-page/printable-easy-sudoku-page.tsx
msgid "A cover page states the puzzle and page counts up front, then {PRINTABLE_BOOKLET_SIZE} puzzles print {PRINTABLE_BOOKLET_PUZZLES_PER_PAGE} to a page so a single sheet holds {PRINTABLE_BOOKLET_PUZZLES_PER_PAGE} complete grids. The last pages hold every solved grid at the same layout, so checking an answer never means hunting through a different page format. The whole file is vector graphics and a standard PDF font, so it prints cleanly at any size a printer supports. Our published sample of {sampleSize} Easy boards measures SE {seRatingRange} — numbers the <0>sudoku difficulty rating guide</0> measures directly rather than assumes."
msgstr "ایک سرورق صفحہ شروع ہی میں پزلز اور صفحات کی تعداد بتاتا ہے، پھر {PRINTABLE_BOOKLET_SIZE} پزلز ہر صفحے پر {PRINTABLE_BOOKLET_PUZZLES_PER_PAGE} کی ترتیب سے چھپتے ہیں، یعنی ایک ورق پر {PRINTABLE_BOOKLET_PUZZLES_PER_PAGE} مکمل گرڈز۔ آخری صفحات میں ہر حل شدہ گرڈ اسی ترتیب میں ہے، اس لیے جواب جانچنے کے لیے کسی مختلف صفحے کی ساخت میں ڈھونڈنا نہیں پڑتا۔ پوری فائل ویکٹر گرافکس اور معیاری PDF فونٹ پر مشتمل ہے، اس لیے پرنٹر جس بھی سائز کو سپورٹ کرے، صاف چھپتی ہے۔ آسان کے {sampleSize} بورڈز کا ہمارا شائع شدہ نمونہ SE {seRatingRange} ناپتا ہے — ایسے اعداد جنہیں <0>سوڈوکو مشکل ریٹنگ گائیڈ</0> مفروضوں کے بجائے براہِ راست ناپتی ہے۔"

#: src/difficulty/components/medium-sudoku-page/medium-sudoku-page.tsx
msgid "A digit confined to two cells of one box that also share a row or column. It can then be erased from the rest of that row or column, since one of those two cells must hold it."
msgstr "ایک ہندسہ جو کسی ایک باکس کے دو خانوں تک محدود ہو اور وہ دونوں خانے ایک ہی قطار یا کالم میں بھی ہوں۔ تب اسے اس قطار یا کالم کے باقی خانوں سے ہٹایا جا سکتا ہے، کیونکہ ان دو خانوں میں سے ایک میں وہ لازماً ہوگا۔"

#: src/how-to-play/components/how-to-play-page/how-to-play-page.tsx
msgid "A finished grid satisfies all three at the same time. That overlap is what makes Sudoku solvable by logic: a digit that is already ruled out by its row, its column and its box has nowhere left to go, which is the basis of almost every solving technique. Every named technique on this site, from the simplest single to the longest chain, is ultimately just a more efficient way of tracking that overlap across many cells at once instead of one cell at a time."
msgstr "مکمل گرڈ تینوں شرائط پر بیک وقت پورا اترتا ہے۔ یہی باہمی تعلق سوڈوکو کو منطق سے حل کے قابل بناتا ہے: جو ہندسہ اپنی قطار، کالم اور باکس سے پہلے ہی رد ہو چکا ہو، اس کے پاس جانے کی کوئی جگہ نہیں رہتی، اور یہی تقریباً ہر حل کی تکنیک کی بنیاد ہے۔ اس سائٹ پر ہر نامزد تکنیک، سب سے سادہ اکہرے سے لے کر سب سے لمبی زنجیر تک، دراصل اسی باہمی تعلق کو ایک ایک خانے کے بجائے بہت سے خانوں میں بیک وقت جانچنے کا ایک زیادہ مؤثر طریقہ ہے۔"

#: src/printable/components/printable-hard-sudoku-page/printable-hard-sudoku-page.tsx
msgid "A fish is easy to miss on a screen where only a handful of cells are visible at once, because the pattern lives in where one digit can go across two, three or four whole lines at the same time. On a full printed grid you can mark that digit’s remaining positions down a column and read the shape off the page. Wings need the opposite view — a few bivalue cells that see each other across the grid — and circling them in pencil makes the overlap obvious. Because both families are easy to apply incorrectly the first few times, checking your work against the solution pages at the back is worth doing every time until the shape becomes automatic."
msgstr "فش اسکرین پر آسانی سے نظر سے رہ جاتی ہے جہاں ایک وقت میں صرف چند خانے دکھائی دیتے ہیں، کیونکہ یہ پیٹرن اس بات میں چھپا ہوتا ہے کہ ایک ہندسہ بیک وقت دو، تین یا چار پوری لائنوں میں کہاں جا سکتا ہے۔ پورے چھپے ہوئے گرڈ پر آپ کسی کالم میں اس ہندسے کی باقی جگہوں کو نشان زد کر کے شکل کو صفحے سے پڑھ سکتے ہیں۔ ونگز کو الٹا زاویہ چاہیے — چند دو امکانات والے خانے جو پورے گرڈ میں ایک دوسرے کو دیکھتے ہیں — اور انہیں پنسل سے دائرے میں لینے سے باہمی تعلق واضح ہو جاتا ہے۔ چونکہ دونوں خاندانوں کو شروع میں غلط لگا دینا آسان ہے، اس لیے جب تک شکل خودبخود نہ پہچانی جانے لگے، ہر بار آخر کے حل کے صفحات سے اپنا کام ملا لینا فائدہ مند ہے۔"

#: src/difficulty/components/hard-sudoku-page/hard-sudoku-page.tsx
msgid "A fish looks at one digit across several lines at once. The X-Wing is the smallest: a digit confined to the same two columns across two rows can be erased from the rest of those columns, because whichever row ends up holding it, the columns are already fixed. A <0>swordfish</0> stretches the same idea over three lines and a jellyfish over four. Finned and sashimi variants relax the base pattern by allowing one extra candidate that still supports a smaller, safe elimination once you account for it — and in our sample they fire far more often than the textbook shapes do. Wings work differently: an XY-Wing links three bivalue cells so a candidate shared between two of them can be erased wherever both can see, XYZ-Wing gives the pivot that candidate too, and W-Wing joins two matching bivalue cells through a strong link on one shared digit. Hard is capped at the W-Wing: a board that still will not move after every fish and wing has been tried is a Nightmare board, not a Hard one."
msgstr "فش ایک ہندسے کو بیک وقت کئی لائنوں میں دیکھتی ہے۔ X-Wing سب سے چھوٹی ہے: جو ہندسہ دو قطاروں میں ایک ہی دو کالموں تک محدود ہو، اسے ان کالموں کے باقی خانوں سے ہٹایا جا سکتا ہے، کیونکہ جو بھی قطار اسے رکھے، کالم پہلے ہی طے ہو چکے ہوتے ہیں۔ <0>Swordfish</0> یہی خیال تین لائنوں تک اور Jellyfish چار تک پھیلاتی ہے۔ فن اور ساشیمی اقسام بنیادی پیٹرن میں ایک اضافی امکان کی گنجائش دیتی ہیں جو اس کا حساب رکھنے کے بعد بھی ایک چھوٹے مگر محفوظ خاتمے کو سہارا دیتا ہے — اور ہمارے نمونے میں یہ نصابی شکلوں سے کہیں زیادہ بار کام آتی ہیں۔ ونگز مختلف طریقے سے کام کرتی ہیں: XY-Wing تین دو امکانات والے خانوں کو یوں جوڑتی ہے کہ ان میں سے دو کا مشترک امکان ہر اس جگہ سے ہٹایا جا سکتا ہے جہاں دونوں نظر ڈال سکیں، XYZ-Wing محور کو بھی وہی امکان دیتی ہے، اور W-Wing دو ایک جیسے دو امکانات والے خانوں کو ایک مشترک ہندسے کے مضبوط رابطے سے ملاتی ہے۔ مشکل W-Wing تک محدود ہے: جو بورڈ ہر فش اور ونگ آزمانے کے بعد بھی نہ ہلے، وہ ڈراؤنا خواب کا بورڈ ہے، مشکل کا نہیں۔"

#: src/printable/components/printable-hard-sudoku-page/printable-hard-sudoku-page.tsx
msgid "A fish spans whole rows or columns at once, which is easier to trace by marking a digit’s remaining positions down a printed column than by scrolling a screen. Wings need the opposite view — a few bivalue cells seen at a glance."
msgstr "فش پوری قطاروں یا کالموں پر بیک وقت پھیلی ہوتی ہے، جسے اسکرول کرتی اسکرین کے بجائے چھپے ہوئے کالم میں ہندسے کی باقی جگہیں نشان زد کر کے دیکھنا آسان ہے۔ ونگز کو الٹا زاویہ چاہیے — چند دو امکانات والے خانے جو ایک نظر میں نظر آ جائیں۔"

#: src/difficulty/components/hell-sudoku-page/hell-sudoku-page.tsx
msgid "A forcing chain, on every board, layered on top of the chains, coloring, fish, wings and subsets the earlier tiers already require. X-Chain, XY-Chain, Simple Coloring and AIC will carry you far, but never all the way through; a <0>Nishio forcing chain</0> is the usual way to break the deadlock."
msgstr "ہر بورڈ پر ایک جبری زنجیر، جو پچھلے درجوں میں پہلے سے درکار زنجیروں، رنگ کاری، فش، ونگز اور سبسیٹس کے اوپر آتی ہے۔ X-Chain، XY-Chain، سادہ رنگ کاری اور AIC آپ کو بہت دور لے جائیں گے، مگر کبھی پوری طرح نہیں؛ اس تعطل کو توڑنے کا عام طریقہ <0>نیشیو جبری زنجیر</0> ہے۔"

