#: src/home/components/home-page/home-page.tsx
msgid "<0>Full House</0> — the simplest possible move, filling the last empty cell in a unit."
msgstr "<0>Última celda libre</0>: el movimiento más sencillo posible, rellenar la única celda vacía que queda en una unidad."

#: src/home/components/home-page/home-page.tsx
msgid "<0>Hidden Single</0> — a digit that only fits in one cell of a unit."
msgstr "<0>Único oculto</0>: un número que solo cabe en una celda de una unidad."

#: src/home/components/home-page/home-page.tsx
msgid "<0>Naked Single</0> — a cell left with exactly one candidate."
msgstr "<0>Único desnudo</0>: una celda a la que solo le queda un candidato."

